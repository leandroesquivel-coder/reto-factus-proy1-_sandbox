# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Factus Challenge Configuration
PORT="3000"

# PostgreSQL Database Configuration (Supabase, Neon, Render, Cloud SQL)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
DB_HOST="your-db-host.supabase.co"
DB_USER="postgres"
DB_NAME="postgres"
DB_PASSWORD="your-db-password"
DB_PORT="5432"
DB_SSL="true"

# Factus API Credentials (OAuth 2.0 Sandbox)
url_api="https://api-sandbox.factus.com.co"
client_id="your-factus-client-id"
client_secret="your-factus-client-secret"
email="your-factus-email@domain.com"
password="your-factus-password"
